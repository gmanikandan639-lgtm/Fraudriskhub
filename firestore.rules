rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unlisted paths to prevent unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for authentication and role verification
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin role verification:
    // 1. Checks if the authenticated user has role == 'admin' in their /users/{userId} document
    // 2. OR document exists in /admins/{userId}
    // 3. OR verified administrator email matching system admin
    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'gmanikandan639@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schema Validation Blueprint for Hunter Identifier Manual Records & Submissions
    function isValidManualRecord(data) {
      return data.hunterId is string &&
             data.hunterId.size() > 0 &&
             data.hunterId.size() <= 256 &&
             data.bankName is string &&
             data.bankName.size() > 0 &&
             data.bankName.size() <= 256;
    }

    // Schema Validation Blueprint for CSV Dataset Metadata
    function isValidCSVDataset(data) {
      return data.fileName is string &&
             data.fileName.size() <= 256;
    }

    // Schema Validation Blueprint for Search History Log
    function isValidSearchHistory(data) {
      return data.query is string &&
             data.query.size() <= 500;
    }

    // -------------------------------------------------------------------------
    // 1. Manual Hunter Reference Records & Submissions Queue
    // - Public / Normal users CAN read (get & list) approved records and active datasets.
    // - Public / Normal users CAN submit new identifier proposals or update requests with approvalStatus == "pending".
    // - ONLY authenticated Admin users can approve, update, or delete records.
    // -------------------------------------------------------------------------
    match /manual_identifiers/{recordId} {
      allow get, list: if true;
      allow create: if isValidId(recordId) && (
                      (request.resource.data.approvalStatus == 'pending' && isValidManualRecord(request.resource.data)) ||
                      isAdmin()
                    );
      allow update: if isValidId(recordId) && (
                      isAdmin() ||
                      (resource.data.approvalStatus == 'pending' && request.resource.data.approvalStatus == 'pending')
                    );
      allow delete: if isAdmin() && isValidId(recordId);
    }

    match /manual_records/{recordId} {
      allow get, list: if true;
      allow create: if isValidId(recordId) && (
                      (request.resource.data.approvalStatus == 'pending' && isValidManualRecord(request.resource.data)) ||
                      isAdmin()
                    );
      allow update: if isValidId(recordId) && (
                      isAdmin() ||
                      (resource.data.approvalStatus == 'pending' && request.resource.data.approvalStatus == 'pending')
                    );
      allow delete: if isAdmin() && isValidId(recordId);
    }

    match /hunter_records/{recordId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(recordId);
    }

    // -------------------------------------------------------------------------
    // 2. Central Reference CSV Datasets & Metadata (/csv_metadata/{docId} & /csv_datasets/{datasetId})
    // - Public can read the active dataset.
    // - ONLY authenticated Admins can upload, replace, or delete reference datasets.
    // -------------------------------------------------------------------------
    match /csv_metadata/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(docId);
    }

    match /csv_datasets/{datasetId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(datasetId) && isValidCSVDataset(request.resource.data);
      allow update: if isAdmin() && isValidId(datasetId) && isValidCSVDataset(request.resource.data);
      allow delete: if isAdmin() && isValidId(datasetId);
    }

    // -------------------------------------------------------------------------
    // 3. Search History Audit Trail (/search_history/{historyId})
    // - Read and create search logs.
    // - ONLY Admins can delete history logs.
    // -------------------------------------------------------------------------
    match /search_history/{historyId} {
      allow get, list: if true;
      allow create: if isValidId(historyId) && isValidSearchHistory(request.resource.data);
      allow update, delete: if isAdmin() && isValidId(historyId);
    }

    // -------------------------------------------------------------------------
    // 4. Visitor Statistics Counters (/visitor_stats/{statId})
    // -------------------------------------------------------------------------
    match /visitor_stats/{statId} {
      allow get, list: if true;
      allow create, update: if isValidId(statId);
      allow delete: if isAdmin() && isValidId(statId);
    }

    // -------------------------------------------------------------------------
    // 5. User Profiles and RBAC Role Management (/users/{userId})
    // - Users can read and update their own profiles.
    // - Normal users cannot self-assign role = "admin" (escalation guard).
    // - Admins can read and manage any user profile.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'admin')) || isAdmin();
      allow update: if (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)) || isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 6. Admin Designation Registry (/admins/{adminId})
    // - Authenticated users can check admin status.
    // - ONLY Admins can write or modify admin designations.
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }
  }
}
